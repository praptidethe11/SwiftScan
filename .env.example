# SwiftScan API Keys Configuration
# Copy this file to .env and set your API keys below for OSINT features.

# Shodan API Key (https://account.shodan.io)
SHODAN_API_KEY=

# VirusTotal API Key (https://www.virustotal.com/gui/user/username/apikey)
VIRUSTOTAL_API_KEY=

# Censys Platform Personal Access Token (https://platform.censys.io -> your avatar -> API Access)
CENSYS_API_TOKEN=
# Optional: Censys organization ID (only needed for organization-scoped accounts)
CENSYS_ORG_ID=
